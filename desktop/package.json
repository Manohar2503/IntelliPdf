{
  "name": "intellipdf-desktop",
  "version": "1.0.0",
  "description": "Desktop application for IntelliPdf",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm install && electron-builder build --windows --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.intellipdf.app",
    "productName": "IntelliPdf",
    "target": "nsis",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.js",
      "package.json",
      "../frontend/dist/**/*",
      "../backend/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
